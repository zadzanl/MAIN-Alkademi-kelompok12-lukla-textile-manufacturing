ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./test.db

# API
API_PORT=8009
API_HOST=0.0.0.0

# CORS
CORS_ORIGINS=http://localhost:3009

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256

# ── Portal auth (prototype) ──────────────────────────────────────────────────
# Seed administrator for "Admin IT" registration approval.
SEED_ADMIN_EMAIL=admin@luka.local
SEED_ADMIN_PASSWORD=Admin#12345

# Session / OTP lifetimes
AUTH_TOKEN_TTL_MINUTES=120
AUTH_REMEMBER_TTL_MINUTES=720
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# SMTP (optional). Leave SMTP_HOST empty for dev: the OTP is written to the
# backend log instead of being emailed. Set these to send real emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@luka.local
SMTP_TLS=true
SMTP_SSL=false
