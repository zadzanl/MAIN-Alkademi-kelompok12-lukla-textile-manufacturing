# Gunakan path relatif agar lewat Vite proxy (JANGAN pakai http://localhost:...)
VITE_API_URL=/api/sampling-spec-rnd
VITE_APP_NAME=Sampling & Spec R&D

# Portal auth API (register/login/change/forgot password). Path relatif lewat
# Vite proxy ke backend port 8009.
VITE_AUTH_URL=/api/auth

# Mode data untuk ops/ledger/payroll: "mock" (default, in-memory) atau "live".
# Untuk live, isi juga VITE_LEDGER_API_URL dan VITE_LEDGER_TOKEN (Bearer JWT).
VITE_LEDGER_MODE=mock
