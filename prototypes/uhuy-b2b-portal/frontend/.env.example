# UHUY B2B — EXTERNAL client portal frontend (port 3010)
# Backend eksternal terpisah berjalan di port 8010.

# Gunakan path relatif agar lewat Vite proxy (JANGAN pakai http://localhost:...).
VITE_PORTAL_API_URL=/api/portal
VITE_PORTAL_AUTH_URL=/api/portal/auth

# Penanda khusus portal eksternal. Biarkan "external" untuk build portal klien.
VITE_PORTAL_SCOPE=external
VITE_APP_NAME=Portal Klien UHUY B2B
