ENV=development
DEBUG=True
LOG_LEVEL=INFO

# API
PORTAL_API_PORT=8010
PORTAL_API_HOST=0.0.0.0

# CORS (external portal frontend)
CORS_ORIGINS=http://localhost:3010

# ── UHUY B2B external portal ─────────────────────────────────────────────────
# Seed internal approver (verifies client registrations).
SEED_ADMIN_EMAIL=admin@uhuy.local
SEED_ADMIN_PASSWORD=Admin#12345

# Session / OTP lifetimes
PORTAL_TOKEN_TTL_MINUTES=120
PORTAL_REMEMBER_TTL_MINUTES=720
PORTAL_OTP_TTL_MINUTES=10
PORTAL_OTP_MAX_ATTEMPTS=5
PORTAL_OTP_COOLDOWN_SECONDS=60

# SMTP (optional). Leave SMTP_HOST empty for dev: the OTP is written to the
# backend log instead of being emailed. Set these to send real emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@uhuy.local
SMTP_TLS=true
SMTP_SSL=false
